<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>Bookshelf Plugin</string>
			<key>CFBundleTypeRole</key><string>None</string>
			<key>LSItemContentTypes</key><array><string>io.github.medicoderhz.bookshelf.plugin</string></array>
			<key>LSTypeIsPackage</key><true/>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(APP_COPYRIGHT)</string>
	<key>BookshelfSupportURL</key>
	<string>$(APP_SUPPORT_URL)</string>
	<key>BookshelfPrivacyURL</key>
	<string>$(APP_PRIVACY_URL)</string>
	<key>BookshelfMetadataContact</key>
	<string>$(APP_METADATA_CONTACT)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>SUFeedURL</key>
	<string>$(BOOKSHELF_UPDATE_FEED_URL)</string>
	<key>BookshelfUpdatesEnabled</key>
	<string>$(BOOKSHELF_UPDATES_ENABLED)</string>
	<key>SUPublicEDKey</key>
	<string>$(BOOKSHELF_UPDATE_PUBLIC_KEY)</string>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUEnableSystemProfiling</key>
	<false/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>io.github.medicoderhz.bookshelf.plugin</string>
			<key>UTTypeDescription</key><string>Bookshelf Plugin</string>
			<key>UTTypeConformsTo</key><array><string>com.apple.package</string></array>
			<key>UTTypeTagSpecification</key>
			<dict><key>public.filename-extension</key><array><string>bookshelfplugin</string></array></dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>org.bookshelf.note-drag</string>
			<key>UTTypeDescription</key><string>Bookshelf note references</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>org.bookshelf.collection-drag</string>
			<key>UTTypeDescription</key><string>Bookshelf collection references</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>org.bookshelf.book-drag</string>
			<key>UTTypeDescription</key><string>Bookshelf book references</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
		</dict>
	</array>
</dict>
</plist>
